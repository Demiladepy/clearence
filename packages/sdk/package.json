{
  "name": "@clearance/sdk",
  "version": "0.1.1",
  "description": "Clearance SDK: Travel-Rule-ready private payments on Stellar",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./dist/wasm/clearance_wasm_bg.wasm",
    "./artifacts/*": "./artifacts/*"
  },
  "files": [
    "dist",
    "artifacts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/wasm/clearance_wasm_bg.wasm dist/wasm/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:testnet": "tsx --test test/testnet.test.ts",
    "test:browser": "esbuild test/browser/entry.ts --bundle --format=esm --platform=browser --target=es2022 --define:global=globalThis --outfile=test/browser/dist/app.js && node test/browser/run.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "0.25.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@stellar/stellar-sdk": "17.4.0",
    "buffer": "6.0.3",
    "tweetnacl": "1.0.3"
  }
}
